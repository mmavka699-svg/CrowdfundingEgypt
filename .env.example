DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Email (Gmail SMTP example — use an App Password, not your normal password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Crowd-Funding Egypt <no-reply@crowdfunding-eg.com>

# Facebook OAuth2 (bonus feature)
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# Google Gemini AI Chatbot
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-3.5-flash
